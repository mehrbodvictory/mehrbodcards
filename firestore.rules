rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    match /matchmaking_lobbies/{lobbyId} {
      allow read: if true;
      allow create: if isValidId(lobbyId);
      allow update: if isValidId(lobbyId);
      allow delete: if true;
    }

    match /mp_rooms/{roomCode} {
      allow read: if true;
      allow create: if isValidId(roomCode);
      allow update: if isValidId(roomCode);
      allow delete: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
